name: "gdino_dynamic"
# ONNX Runtime backend instead of TensorRT. The TAO GDINO ONNX export
# uses the `LayerNormalization` op (opset 17+), which TensorRT 8.5
# (shipped with Triton 22.12, which is the newest Triton compatible with
# the SageMaker ml.g5 host's NVIDIA driver 470) cannot import natively.
# ORT 1.13.1 (also in Triton 22.12) supports it. Trade-off: ORT inference
# is ~2-3x slower than TRT for transformer-shaped models — fine for our
# batch-ingest workload, would matter for real-time hosting.
platform: "onnxruntime_onnx"
max_batch_size: 8

input [
  {
    name: "inputs"
    data_type: TYPE_FP32
    dims: [3, 544, 960]
  },
  {
    name: "input_ids"
    data_type: TYPE_INT64
    dims: [256]
  },
  {
    name: "attention_mask"
    data_type: TYPE_BOOL
    dims: [256]
  },
  {
    name: "position_ids"
    data_type: TYPE_INT64
    dims: [256]
  },
  {
    name: "token_type_ids"
    data_type: TYPE_INT64
    dims: [256]
  },
  {
    name: "text_token_mask"
    data_type: TYPE_BOOL
    dims: [256, 256]
  }
]

output [
  {
    name: "pred_logits"
    data_type: TYPE_FP32
    dims: [-1, -1]
  },
  {
    name: "pred_boxes"
    data_type: TYPE_FP32
    dims: [-1, 4]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [0]
  }
]
