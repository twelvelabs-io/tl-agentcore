name: "reid"
platform: "onnxruntime_onnx"
# The TAO ReID ONNX exports with dynamic shapes on both input and output
# (`[-1, -1]` for fc_pred). With max_batch_size>0 Triton prepends a batch
# dim to the configured dims; that produces `[N, 256]` which doesn't match
# the model's `[-1, -1]`. Setting max_batch_size=0 lets us declare the full
# shape explicitly (including the dynamic batch dim), matching the model.
max_batch_size: 0

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [-1, 3, 256, 128]
  }
]

output [
  {
    name: "fc_pred"
    data_type: TYPE_FP32
    # ONNX export has dynamic dims on both axes ([-1, -1]). Triton requires
    # the config shape to match the model's exported shape exactly — even
    # though we *know* the feature dim is 256, the model proto claims it's
    # dynamic, so we mirror that here. Downstream callers in tracker.py
    # treat the result as 256-dim regardless.
    dims: [-1, -1]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [0]
  }
]
