# arm64 wheels pre-downloaded by the operator before docker build
agent/wheels/

# Lambda zip artifacts — regenerated by `terraform apply` (data.archive_file).
# Tracking them inflates the repo + diff noise. Keep the directory empty so
# Terraform's local.fqname references resolve, but don't ship the binaries.
infra/.build/*.zip

# Playwright test outputs.
ui/playwright-report/
ui/test-results/

# Release artifacts (built by scripts/make_release.py).
release/

# Claude Code project files (operator-local, not deployable).
CLAUDE.md
.claude/

# Cursor / editor metadata.
.cursor/
