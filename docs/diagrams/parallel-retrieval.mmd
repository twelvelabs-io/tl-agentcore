flowchart TD
    U(["Producer · build me a 60 s action highlight reel"]) --> A1[Agent · parse brief into beats]

    A1 --> VFan{{"parallel fan-out · one vector_search per beat"}}

    subgraph VS["vector_search · S3 Vectors · ~250 ms each"]
