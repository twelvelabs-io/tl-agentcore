{
  "name": "tl-agentcore-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n proxy,vite -c yellow,cyan \"npm run proxy\" \"vite\"",
    "proxy": "node server/proxy.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:comprehensive": "playwright test e2e/comprehensive/",
    "test:e2e:comprehensive:loop": "node e2e/comprehensive/loop-runner.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.2",
    "amazon-cognito-identity-js": "^6.3.16",
    "d3-force": "^3.0.0",
    "hls.js": "^1.6.16",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-3d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1062.0",
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.5"
  }
}
