# Placeholders — the real values are written by deploy.sh from
# terraform outputs at deploy time and land in .env.production
# (gitignored). Copy this file to .env.local for dev overrides.

# Local dev — leave empty to use the local proxy in ui/server/proxy.mjs.
VITE_AGENT_URL=

# Deployed values (all filled in by deploy.sh):
VITE_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:<account>:runtime/<runtime-id>
VITE_AGENT_RUNTIME_REGION=us-east-1
VITE_AGENT_RUNTIME_QUALIFIER=live
VITE_COGNITO_USER_POOL_ID=us-east-1_<pool-id>
VITE_COGNITO_HOSTED_UI_DOMAIN=https://<pool-prefix>-<account>.auth.us-east-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=<client-id>
VITE_AWS_REGION=us-east-1
VITE_FRONTEND_URL=https://<cloudfront-distribution>.cloudfront.net
