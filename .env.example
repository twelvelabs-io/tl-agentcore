# TwelveLabs
TL_API_KEY=tlk_...
TL_BASE_URL=https://api.twelvelabs.io/v1.3

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default

# Agent (local dev — Strands picks Bedrock by default)
AGENT_MODEL_ID=us.anthropic.claude-sonnet-4-6

# profile_cache table (DDB) — populated by scripts/ingest_profile_cache.py
PROFILE_CACHE_TABLE=tl-agentcore-profile-cache

# Optional: AgentCore Gateway MCP URL (Phase 2 only)
# GATEWAY_MCP_URL=https://<gateway-id>.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp
