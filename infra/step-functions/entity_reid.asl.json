{
  "Comment": "Phase 3-proper entity Re-ID ingest. For one knowledge_store, enumerates cached assets, invokes the gdino SageMaker Async endpoint per asset (scale-to-zero ml.g5.xlarge), Titan-embeds the resulting patch crops, upserts into the entity-patches S3 Vectors index. Per-asset failures are captured but don't abort the whole map.",
  "StartAt": "ListAssets",
  "States": {
    "ListAssets": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${LIST_ASSETS_FN_ARN}",
        "Payload": {
          "ks_id.$":          "$.ks_id",
          "execution_name.$": "$$.Execution.Name",
          "text_prompt.$":    "$.text_prompt",
          "fps.$":            "$.fps",
          "limit.$":          "$.limit"
        }
      },
      "ResultSelector": {
        "ks_id.$":          "$.Payload.ks_id",
        "execution_name.$": "$.Payload.execution_name",
        "assets.$":         "$.Payload.assets"
      },
      "ResultPath": "$.listed",
      "Next": "HasAssets"
    },

    "HasAssets": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.listed.assets[0]",
          "IsPresent": true,
          "Next": "MapAssets"
        }
      ],
      "Default": "EmptyKB"
    },

    "EmptyKB": {
      "Type": "Pass",
      "Result": { "status": "no_assets", "patches_embedded": 0 },
      "End": true
    },

    "MapAssets": {
      "Type": "Map",
      "ItemsPath": "$.listed.assets",
      "MaxConcurrency": 2,
      "Parameters": {
        "ks_id.$":  "$.listed.ks_id",
        "asset.$":  "$$.Map.Item.Value"
      },
      "Iterator": {
        "StartAt": "InvokeAsync",
        "States": {
          "InvokeAsync": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${INVOKE_ASYNC_FN_ARN}",
              "Payload": {
                "ks_id.$": "$.ks_id",
                "asset.$": "$.asset"
              }
            },
            "ResultSelector": {
              "asset_id.$":        "$.Payload.asset_id",
              "output_location.$": "$.Payload.output_location",
              "inference_id.$":    "$.Payload.inference_id",
              "elapsed_ms.$":      "$.Payload.elapsed_ms"
            },
            "ResultPath": "$.invocation",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
                "IntervalSeconds": 5,
                "MaxAttempts": 3,
                "BackoffRate": 2.0
              }
            ],
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "AssetFailed",
                "ResultPath": "$.error"
              }
            ],
            "Next": "EmbedPatches"
          },

          "EmbedPatches": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${EMBED_PATCHES_FN_ARN}",
              "Payload": {
                "ks_id.$":           "$.ks_id",
                "asset_id.$":        "$.asset.asset_id",
                "output_location.$": "$.invocation.output_location"
              }
            },
            "ResultSelector": {
              "asset_id.$":         "$.Payload.asset_id",
              "patches_embedded.$": "$.Payload.patches_embedded",
              "elapsed_ms.$":       "$.Payload.elapsed_ms"
            },
            "ResultPath": "$.embedded",
            "Catch": [
              {
                "ErrorEquals": ["States.ALL"],
                "Next": "AssetFailed",
                "ResultPath": "$.error"
              }
            ],
            "End": true
          },

          "AssetFailed": {
            "Type": "Pass",
            "Parameters": {
              "asset_id.$": "$.asset.asset_id",
              "error.$":    "$.error",
              "status":     "failed"
            },
            "End": true
          }
        }
      },
      "ResultPath": "$.results",
      "End": true
    }
  }
}
